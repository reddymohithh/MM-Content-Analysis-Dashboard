# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored and never committed (see .gitignore) — this .env.example file
# is the only env-related file that belongs in the repo.

# Neon Postgres connection string (Neon dashboard -> your project -> Connect).
# Leave unset for local preview: the app falls back to a bundled synthetic
# demo dataset (src/lib/synthetic-data.ts) when DATABASE_URL isn't set.
DATABASE_URL=

# Beehiiv REST API v2. Get the key from Beehiiv -> Settings -> Integrations ->
# API. Only needed for scripts/seed-from-beehiiv.ts (real-data sync); the app
# itself never calls Beehiiv directly at request time.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=pub_a5a04dd9-d851-4864-bf87-7a105c812c27

# Single shared password gating the whole deployed app (see src/proxy.ts).
# Leave unset to disable the gate entirely (e.g. local dev).
SITE_PASSWORD=

# Editorial content-quality scoring (the "Analyze content" navbar button,
# see src/lib/scoring/content-quality.ts). Local-only -- never set these on
# the public deployment, both for cost control and because scoring only
# makes sense against real Beehiiv content anyway.
OPENAI_API_KEY=

# Which model actually scores content. Provider swap = new file in
# src/lib/llm/providers/ + one line in src/lib/llm/index.ts; model swap =
# just change this value. Defaults match these if unset.
CONTENT_QUALITY_LLM_PROVIDER=openai
CONTENT_QUALITY_LLM_MODEL=gpt-5.6-luna
